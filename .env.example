# ------------------------------------------------------------------
# Bangarpet Property Hub - environment configuration
# Copy to .env and fill in real values. NEVER commit .env to Git.
# ------------------------------------------------------------------

# development | production
DJANGO_SETTINGS_MODULE=config.settings.development

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (scheme + host) allowed to POST forms, comma separated
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Public base URL used in emails, sitemaps and payment callbacks
SITE_URL=http://localhost:8000

# Super admin login, created/updated by `python manage.py ensure_admin`
# (run automatically by run_local.sh / run_local.bat and scripts/release.sh).
# Set the password here or in your host's environment settings. Never commit it.
ADMIN_USERNAME=bph@admin
ADMIN_PASSWORD=
ADMIN_NAME=BPH Admin

# Database. Defaults to SQLite (db.sqlite3) when empty.
# PostgreSQL example: postgres://bph_user:password@localhost:5432/bph
DATABASE_URL=

# Google Maps JavaScript API (restrict the key to your domain in Google Cloud Console)
GOOGLE_MAPS_API_KEY=

# Razorpay (use rzp_test_ keys until you are ready to go live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Business Cloud API (Meta). Templates must be approved in WhatsApp Manager.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
# Language code used when sending approved templates
WHATSAPP_TEMPLATE_LANGUAGE=en

# Email (SMTP). Leave EMAIL_HOST empty in development to print emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Bangarpet Property Hub <no-reply@example.com>

# Storage locations (absolute paths recommended in production)
MEDIA_ROOT=
PRIVATE_MEDIA_ROOT=
STATIC_ROOT=
# Serve uploaded photos from Django when there is no Nginx/Apache alias for /media/
# (Docker, Render, Railway). Leave False when the web server serves /media/.
SERVE_MEDIA=False

# Docker Compose only: password for the bundled PostgreSQL container
POSTGRES_PASSWORD=

# Gunicorn (optional). On platforms that set $PORT the app binds 0.0.0.0:$PORT automatically.
# Behind a platform proxy (Render, Railway, Docker) set FORWARDED_ALLOW_IPS=*
FORWARDED_ALLOW_IPS=127.0.0.1
GUNICORN_WORKERS=3

# Production security (production settings only)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Set to True when the app runs behind a proxy that sets X-Forwarded-Proto
USE_X_FORWARDED_PROTO=True

# Verification document retention (days) after a decision
VERIFICATION_DOC_RETENTION_DAYS=180
