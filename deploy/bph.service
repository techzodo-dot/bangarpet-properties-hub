# /etc/systemd/system/bph.service
[Unit]
Description=Bangarpet Property Hub (Gunicorn)
After=network.target

[Service]
User=bph
Group=www-data
WorkingDirectory=/srv/bph/app
EnvironmentFile=/srv/bph/app/.env
ExecStart=/srv/bph/venv/bin/gunicorn -c gunicorn.conf.py config.wsgi:application
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
